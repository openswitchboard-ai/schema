{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.openswitchboard.ai/v0/deny-list.json",
  "title": "Category deny list",
  "description": "Prohibited categories per jurisdiction. A card whose category matches a denied glob for the poster's jurisdiction is rejected with CATEGORY_PROHIBITED. Entries with status 'vertical-policy-pending' mark grey zones the operator has not yet opened rather than hard prohibitions.",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "common.json#/$defs/schemaVersion" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "jurisdiction": {
            "description": "ISO 3166-1 alpha-2 country code, or '*' for all jurisdictions.",
            "type": "string",
            "pattern": "^([A-Z]{2}|\\*)$"
          },
          "denied": {
            "description": "Category globs, e.g. 'goods.weapons.**'.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*(\\.([a-z][a-z0-9-]*|\\*\\*|\\*))*$"
            }
          },
          "reason_code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "status": {
            "type": "string",
            "enum": ["denied", "vertical-policy-pending"],
            "default": "denied"
          }
        },
        "required": ["jurisdiction", "denied", "reason_code"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "entries"],
  "additionalProperties": false
}

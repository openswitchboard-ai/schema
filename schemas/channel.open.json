{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.openswitchboard.ai/v0/channel.open.json",
  "title": "Stage 4 - channel.open",
  "description": "A direct channel between the two parties is opened. The switchboard steps back to carrier role.",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "common.json#/$defs/schemaVersion" },
    "kind": { "const": "channel.open" },
    "match_id": { "$ref": "common.json#/$defs/matchId" },
    "channel": {
      "type": "object",
      "properties": {
        "medium": {
          "description": "v1 supports switchboard-mediated in-app messaging only.",
          "type": "string",
          "enum": ["in-app"]
        },
        "channel_id": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "required": ["medium", "channel_id"],
      "additionalProperties": false
    },
    "opened_at": { "type": "string", "format": "date-time" }
  },
  "required": ["schema_version", "kind", "match_id", "channel", "opened_at"],
  "additionalProperties": false
}

{
  "schema_version": "0.2.0",
  "notes": "v2 taxonomy for OpenSwitchboard. goods.*, services.* and social.* are open; work.* and property.* are reserved. A node may also carry \"status\": \"reserved\" with a \"reserved_reason\" - licensed-trade for work that needs a licence, regulated-vertical for a family held back deliberately at launch. A category may be posted only when its top level is open and no node on its path (itself included) is reserved. The taxonomy is maintained by the operator in public (benevolent-dictator for now; a governance group is planned once third-party verticals exist). See CONTRIBUTING.md for the taxonomy-change process.",
  "common_attributes": {
    "condition": {"type":"enum","values":["new","like-new","good","fair","parts-only"]},
    "brand": {"type":"string"},
    "model": {"type":"string"},
    "colour": {"type":"string"},
    "year": {"type":"integer"},
    "language": {"type":"string"},
    "proficiency": {"type":"enum","values":["beginner","intermediate","advanced","native"]},
    "format": {"type":"enum","values":["in-person","online","either"]},
    "frequency": {"type":"enum","values":["once","weekly","fortnightly","monthly","ongoing"]},
    "experience": {"type":"enum","values":["none","some","experienced"]},
    "day_part": {"type":"enum","values":["morning","afternoon","evening","weekend","flexible"]},
    "duration_min": {"type":"integer"},
    "group_size": {"type":"integer"}
  },
  "top_levels": {
    "goods": {"status":"open"},
    "services": {"status":"open"},
    "social": {"status":"open"},
    "work": {"status":"reserved","reason":"not yet open"},
    "property": {"status":"reserved","reason":"not yet open"}
  },

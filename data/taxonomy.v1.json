{
  "schema_version": "0.1.0",
  "notes": "v1 taxonomy for OpenSwitchboard. Only goods.* is open. The taxonomy is maintained by the operator in public (benevolent-dictator for now; a governance group is planned once third-party verticals exist). See CONTRIBUTING.md for the taxonomy-change process.",
  "common_attributes": {
    "condition": { "type": "enum", "values": ["new", "like-new", "good", "fair", "parts-only"] },
    "brand": { "type": "string" },
    "model": { "type": "string" },
    "colour": { "type": "string" },
    "year": { "type": "integer" }
  },
  "top_levels": {
    "goods": { "status": "open" },
    "services": { "status": "reserved, not yet open" },
    "social": { "status": "reserved, not yet open" },
    "work": { "status": "reserved, not yet open" },
    "property": { "status": "reserved, not yet open" }
  },
  "nodes": {
    "goods": { "label": "Secondhand consumer goods" },
    "goods.bicycle": { "label": "Bicycles", "attributes": { "frame_size": { "type": "string" }, "wheel_size_in": { "type": "number" } } },
    "goods.bicycle.mountain": { "label": "Mountain bikes", "attributes": { "suspension": { "type": "enum", "values": ["rigid", "hardtail", "full"] } } },
    "goods.bicycle.road": { "label": "Road bikes" },
    "goods.bicycle.kids": { "label": "Kids bikes" },
    "goods.bicycle.electric": { "label": "E-bikes", "attributes": { "battery_wh": { "type": "number" } } },
    "goods.furniture": { "label": "Furniture", "attributes": { "material": { "type": "string" }, "width_cm": { "type": "number" }, "height_cm": { "type": "number" }, "depth_cm": { "type": "number" } } },
    "goods.furniture.sofa": { "label": "Sofas", "attributes": { "seats": { "type": "integer" } } },
    "goods.furniture.table": { "label": "Tables" },
    "goods.furniture.chair": { "label": "Chairs" },
    "goods.furniture.bed": { "label": "Beds", "attributes": { "bed_size": { "type": "enum", "values": ["single", "double", "queen", "king"] } } },
    "goods.furniture.storage": { "label": "Storage & shelving" },
    "goods.electronics": { "label": "Electronics" },
    "goods.electronics.phone": { "label": "Phones", "attributes": { "storage_gb": { "type": "integer" }, "unlocked": { "type": "boolean" } } },
    "goods.electronics.laptop": { "label": "Laptops", "attributes": { "storage_gb": { "type": "integer" }, "ram_gb": { "type": "integer" }, "screen_in": { "type": "number" } } },
    "goods.electronics.tablet": { "label": "Tablets", "attributes": { "storage_gb": { "type": "integer" } } },
    "goods.electronics.camera": { "label": "Cameras", "attributes": { "lens_mount": { "type": "string" }, "shutter_count": { "type": "integer" } } },
    "goods.electronics.audio": { "label": "Audio equipment" },
    "goods.electronics.tv": { "label": "TVs", "attributes": { "screen_in": { "type": "number" } } },
    "goods.electronics.console": { "label": "Game consoles" },
    "goods.appliances": { "label": "Appliances" },
    "goods.appliances.kitchen": { "label": "Kitchen appliances" },
    "goods.appliances.laundry": { "label": "Laundry appliances" },
    "goods.appliances.climate": { "label": "Heating & cooling" },
    "goods.clothing": { "label": "Clothing", "attributes": { "size": { "type": "string" } } },
    "goods.clothing.adult": { "label": "Adult clothing" },
    "goods.clothing.kids": { "label": "Kids clothing" },
    "goods.clothing.shoes": { "label": "Shoes" },
    "goods.clothing.accessories": { "label": "Accessories" },
    "goods.sports": { "label": "Sports & outdoors" },
    "goods.sports.fitness": { "label": "Fitness equipment" },
    "goods.sports.outdoor": { "label": "Camping & hiking" },
    "goods.sports.water": { "label": "Water sports" },
    "goods.sports.winter": { "label": "Winter sports" },
    "goods.music": { "label": "Musical instruments" },
    "goods.music.guitar": { "label": "Guitars", "attributes": { "handedness": { "type": "enum", "values": ["right", "left"] } } },
    "goods.music.keyboard": { "label": "Keyboards & pianos" },
    "goods.music.drums": { "label": "Drums & percussion" },
    "goods.baby": { "label": "Baby & nursery" },
    "goods.baby.stroller": { "label": "Strollers & prams" },
    "goods.baby.cot": { "label": "Cots" },
    "goods.baby.carseat": { "label": "Car seats", "attributes": { "expiry_year": { "type": "integer" } } },
    "goods.baby.toys": { "label": "Baby toys" },
    "goods.tools": { "label": "Tools" },
    "goods.tools.power": { "label": "Power tools" },
    "goods.tools.hand": { "label": "Hand tools" },
    "goods.tools.garden": { "label": "Garden tools" },
    "goods.books-media": { "label": "Books & media" },
    "goods.toys-games": { "label": "Toys & games" }
  }
}
